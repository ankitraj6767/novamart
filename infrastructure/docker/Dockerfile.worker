FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /workspace
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY services/worker-service ./services/worker-service
RUN pnpm install --frozen-lockfile

FROM base AS build
RUN pnpm --filter @novamart/worker-service build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=base /workspace/node_modules ./node_modules
COPY --from=base /workspace/packages ./packages
COPY --from=build /workspace/services/worker-service/dist ./services/worker-service/dist
COPY --from=base /workspace/services/worker-service/package.json ./services/worker-service/package.json
CMD ["node", "services/worker-service/dist/main.js"]
