{
  "name": "@novamart/commerce-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-fastify": "10.4.15",
    "@novamart/config": "workspace:*",
    "@novamart/domain": "workspace:*",
    "@novamart/events": "workspace:*",
    "@novamart/logger": "workspace:*",
    "@novamart/permissions": "workspace:*",
    "@novamart/types": "workspace:*",
    "@novamart/validation": "workspace:*",
    "fastify": "4.29.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "postgres": "3.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
