{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.md", "*.yml", "*.yaml"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.sql"],
      "options": { "printWidth": 120 }
    }
  ]
}
