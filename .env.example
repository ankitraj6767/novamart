# ==============================================================================
# NovaMart — environment template
#
# Copy to .env.local and fill in. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ / DART_DEFINE_ are exposed to clients:
# only publishable, non-secret values may go there.
# ==============================================================================

NODE_ENV=development
APP_ENV=local                              # local | development | staging | production
LOG_LEVEL=debug                            # trace|debug|info|warn|error|fatal

# ------------------------------------------------------------------------------
# Supabase — public (safe for clients)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://qeayqpxyhbcybmttdrgp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ey-Dq4Ev7nb-vZZE_orVng_YsUKK_fZ

# Local Supabase stack (supabase start)
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=

# ------------------------------------------------------------------------------
# Supabase — server only. NEVER expose to browser or Flutter.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://qeayqpxyhbcybmttdrgp.supabase.co
SUPABASE_SECRET_KEY=                       # sb_secret_... (service role equivalent)
SUPABASE_PROJECT_REF=qeayqpxyhbcybmttdrgp
SUPABASE_JWT_ISSUER=https://qeayqpxyhbcybmttdrgp.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://qeayqpxyhbcybmttdrgp.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=                      # required by: supabase link / db push

# ------------------------------------------------------------------------------
# Database (commerce-api / workers)
# Use the SESSION pooler (5432) for migrations, TRANSACTION pooler (6543) for the app.
# postgres.js must run with prepare=false against the transaction pooler.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_PREPARE=false
# Dedicated smaller pool for checkout/payments so discovery traffic cannot starve them
DATABASE_CRITICAL_POOL_MAX=10
# Optional read replica for reporting
DATABASE_REPLICA_URL=

# ------------------------------------------------------------------------------
# commerce-api
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_PATH=/api
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
API_BODY_LIMIT_BYTES=2097152
API_REQUEST_TIMEOUT_MS=30000
API_TRUST_PROXY=true
INTERNAL_SERVICE_TOKEN_SECRET=             # HMAC secret for worker→API service tokens

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=novamart:local:
REDIS_TLS=false
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_PRODUCT_TTL_SECONDS=600
CACHE_CATEGORY_TTL_SECONDS=3600
CACHE_PERMISSION_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# Typesense
# ------------------------------------------------------------------------------
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_ADMIN_API_KEY=                   # server only
TYPESENSE_SEARCH_ONLY_API_KEY=             # safe for clients if used directly
NEXT_PUBLIC_TYPESENSE_HOST=127.0.0.1
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_KEY=

# ------------------------------------------------------------------------------
# Payments — Razorpay (server only)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay                  # razorpay | cashfree | mock (local/test only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_CURRENCY=INR
NEXT_PUBLIC_RAZORPAY_KEY_ID=               # publishable key id only, never the secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ------------------------------------------------------------------------------
# Logistics (server only)
# ------------------------------------------------------------------------------
SHIPPING_PROVIDER=mock                     # shiprocket | delhivery | mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
SHIPPING_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Notifications (server only)
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
SMS_PROVIDER=mock                          # msg91 | mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
EMAIL_PROVIDER=mock                        # ses | resend | mock
EMAIL_FROM=NovaMart <no-reply@novamart.in>
RESEND_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=commerce-api
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# Web apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://127.0.0.1:54321/storage/v1/object/public
NEXT_PUBLIC_APP_NAME=NovaMart
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_SUPPORTED_LOCALES=en-IN,hi-IN

# ------------------------------------------------------------------------------
# Flutter (passed via --dart-define-from-file; publishable values only)
# ------------------------------------------------------------------------------
DART_DEFINE_API_BASE_URL=http://10.0.2.2:4000/api/v1
DART_DEFINE_SUPABASE_URL=https://qeayqpxyhbcybmttdrgp.supabase.co
DART_DEFINE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ey-Dq4Ev7nb-vZZE_orVng_YsUKK_fZ

# ------------------------------------------------------------------------------
# Business defaults — runtime values live in platform.platform_settings.
# These are bootstrap seeds only.
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
RESERVATION_TTL_MINUTES=15
CHECKOUT_SESSION_TTL_MINUTES=30
IDEMPOTENCY_RETENTION_DAYS=30
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8

# ------------------------------------------------------------------------------
# Feature flag bootstrap (authoritative values in platform.feature_flags)
# ------------------------------------------------------------------------------
FLAG_COD_ENABLED=true
FLAG_UPI_ENABLED=true
FLAG_AI_ASSISTANT_ENABLED=false
FLAG_FLASH_SALE_ENABLED=true
FLAG_SELLER_ADS_ENABLED=false
FLAG_NEW_CHECKOUT_ENABLED=false
